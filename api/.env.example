# Guardian API Configuration
# Copy to .env and fill in values

# Application
APP_NAME="Guardian API"
APP_ENV="development"
DEBUG=true
LOG_LEVEL="INFO"

# Database
DATABASE_URL="postgresql+asyncpg://guardian:guardian@localhost:5432/guardian"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL="redis://localhost:6379/0"
REDIS_CACHE_TTL=3600

# Security
SECRET_KEY="change-me-in-production-use-strong-random-key"
DEVICE_TOKEN_TTL_DAYS=365
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# External APIs (optional - for deep analysis)
GOOGLE_SAFE_BROWSING_API_KEY=""
VIRUSTOTAL_API_KEY=""
ABUSEIPDB_API_KEY=""
URLHAUS_API_KEY=""
PHISHTANK_API_KEY=""

# ML Model
MODEL_PATH="ml/models/guardian_model.joblib"
MODEL_VERSION="1.0.0"

# Blocklist
BLOCKLIST_SYNC_INTERVAL_SECONDS=300
BLOCKLIST_CACHE_TTL=86400