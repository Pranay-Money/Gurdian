# Guardian API - Production Environment Variables
# Copy to .env.production and fill in actual values
# NEVER commit this file with real secrets!

# =============================================================================
# Application
# =============================================================================
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=your-strong-random-64-char-secret-key-here-generate-with-openssl-rand-base64-48

# CORS - MUST match your Chrome extension ID in production
# Format: chrome-extension://<extension-id>
# Get extension ID from chrome://extensions in developer mode
CORS_ALLOWED_ORIGINS=chrome-extension://abcdefghijklmnopqrstuvwxyz123456

# =============================================================================
# Database (Managed PostgreSQL - Fly.io, Render, Google Cloud SQL, etc.)
# =============================================================================
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://guardian:strong-password@your-db-host:5432/guardian
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# =============================================================================
# Redis (Managed Redis - Fly.io, Render, Google Cloud Memorystore, etc.)
# =============================================================================
# Format: redis://[:password@]host:port/db
REDIS_URL=redis://:strong-password@your-redis-host:6379/0
REDIS_CACHE_TTL=3600

# =============================================================================
# Device Tokens
# =============================================================================
DEVICE_TOKEN_TTL_DAYS=365
DEVICE_TOKEN_ROTATION_GRACE_SECONDS=300

# =============================================================================
# Rate Limits
# =============================================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
ANALYZE_RATE_LIMIT=30

# =============================================================================
# Intel API Keys (Optional - adapters degrade gracefully without them)
# =============================================================================
# Get from: https://developers.google.com/safe-browsing
GOOGLE_SAFE_BROWSING_API_KEY=

# Get from: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# Get from: https://www.phishtank.com/developer_info.php
PHISHTANK_API_KEY=

# Get from: https://urlhaus.abuse.ch/api/
URLHAUS_API_KEY=

# =============================================================================
# Intel Adapter Config (Per Adapter)
# =============================================================================
GSB_TIMEOUT=5
GSB_RATE_LIMIT=10000
VT_TIMEOUT=10
VT_RATE_LIMIT=500
OP_TIMEOUT=30
OP_RATE_LIMIT=10
PT_TIMEOUT=30
PT_RATE_LIMIT=10
RDAP_TIMEOUT=5
RDAP_RATE_LIMIT=100
DNS_TIMEOUT=3
DNS_RATE_LIMIT=200
TLS_TIMEOUT=5
TLS_RATE_LIMIT=100

# =============================================================================
# Cache TTL by Verdict (Seconds)
# =============================================================================
CACHE_TTL_MALICIOUS=86400
CACHE_TTL_SUSPICIOUS=21600
CACHE_TTL_CLEAN=3600
CACHE_TTL_UNKNOWN=300

# =============================================================================
# Privacy
# =============================================================================
RETENTION_DAYS=30
DEFAULT_STORE_RAW_TEXT=false

# =============================================================================
# Blocklist
# =============================================================================
BLOCKLIST_SYNC_INTERVAL_SECONDS=300
BLOCKLIST_MAX_AGE_DAYS=30
BLOCKLIST_VERSION_KEY=blocklist:version

# =============================================================================
# Observability
# =============================================================================
# Get from: https://sentry.io/settings/<org>/projects/<project>/keys/
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1