# Guardian - Root Environment Example
# Copy to .env and fill in actual values

# =============================================================================
# API Production (used by docker-compose.prod.yml)
# =============================================================================
POSTGRES_USER=guardian
POSTGRES_PASSWORD=your-strong-postgres-password
POSTGRES_DB=guardian

# API Secrets (also set in Fly.io secrets)
SECRET_KEY=your-strong-random-64-char-secret-key

# Intel API Keys
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
PHISHTANK_API_KEY=
URLHAUS_API_KEY=

# CORS - Chrome Extension ID (get from chrome://extensions in dev mode)
CORS_ALLOWED_ORIGINS=["chrome-extension://abcdefghijklmnopqrstuvwxyz123456"]

# Observability
SENTRY_DSN=
GRAFANA_PASSWORD=your-grafana-password

# =============================================================================
# Extension Development
# =============================================================================
VITE_API_URL=http://localhost:8000