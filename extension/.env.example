# Guardian Extension - Environment Variables
# Copy to .env.local and fill in actual values
# DO NOT COMMIT .env.local with real values!

# Production API origin (used in production build)
API_ORIGIN=https://api.guardian.example

# For local development against local API
# API_ORIGIN=http://localhost:8000

# For staging
# API_ORIGIN=https://guardian-api-staging.fly.dev