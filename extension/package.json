{
  "name": "guardian-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-vite.mjs build --watch --mode development",
    "build": "node scripts/run-vite.mjs build --mode production && npm run verify-dist",
    "build:prod": "node scripts/validate-api-origin.mjs && node scripts/run-vite.mjs build --mode production --config vite.config.prod.ts && npm run verify-dist",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:bloom": "tsx scripts/generate-bloom.ts",
    "generate:icons": "tsx scripts/generate-icons.ts",
    "verify-dist": "node scripts/verify-dist.mjs",
    "pack": "bash scripts/build-prod.sh"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.0.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.0.0",
    "dexie": "^4.0.0",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.10.0",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.258",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/sharp": "^0.31.1",
    "@types/webextension-polyfill": "^0.12.6",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "globals": "^15.0.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
